# --- Какая модель отвечает: gemini (бесплатный тариф Google) или claude ---
LLM_PROVIDER=gemini
# Ключ Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# запасные модели, если основная перегружена (ошибка 503)
GEMINI_FALLBACK_MODELS=gemini-flash-latest

# --- Claude API (если LLM_PROVIDER=claude) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high  (для чата поддержки обычно хватает low/medium)
CLAUDE_EFFORT=low

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
# Чат/группа IT-отдела, куда бот пересылает эскалации (необязательно)
IT_SUPPORT_CHAT_ID=

# --- База знаний: local | notion | confluence (можно через запятую) ---
KB_SOURCES=local
KB_LOCAL_DIR=data/kb
NOTION_TOKEN=
CONFLUENCE_BASE_URL=https://your-company.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=IT

# --- Тикеты: mock | jira ---
TICKETS_BACKEND=mock
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SERVICE_DESK_ID=1
JIRA_REQUEST_TYPE_ID=10
MOCK_TICKETS_FILE=data/tickets.jsonl

GUIDES_DIR=data/guides
